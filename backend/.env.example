# Copy this file to `.env` and adjust as needed.
# All settings have sensible defaults in app/core/config.py, so the `.env` file is optional.

# JWT signing key (change in production)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Path to the YOLOv8 license-plate detection weights
DETECT_MODEL_PATH=./weights/best.pt

# Set to True to run the OCR engine on GPU (requires compatible GPU + drivers)
OCR_USE_GPU=False
